          <alias key='&quot;[federated.19q8dpo1ls4fjn118hm4i0l6jhlx].[sum:operating_cost_usd:qk]&quot;' value='Operating Cost (USD)' />
          <alias key='&quot;[federated.19q8dpo1ls4fjn118hm4i0l6jhlx].[usr:Calculation_1122394328907776:qk]&quot;' value='Cost per Recorded Visit (USD)' />
          <alias key='&quot;[federated.19q8dpo1ls4fjn118hm4i0l6jhlx].[usr:Calculation_1122394329018369:qk]&quot;' value='Cost per Recorded Attendance-Hour (USD)' />
