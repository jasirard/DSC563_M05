    <worksheet name='Improvement 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='16'>Workshop coordinator: Which topic and</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='16'>delivery format should recieve priority for one additional pilot session?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#1f1f1f' fontsize='12'>Base view selected: </run>
            <run fontcolor='#1f1f1f' fontsize='12'>New visualization chart.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f1f1f' fontsize='12'>Source or feedback used:</run>
            <run fontcolor='#1f1f1f' fontsize='12'> Practice from Colab workbook.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f1f1f' fontsize='12'>Specific guidance and modification:</run>
            <run fontcolor='#1f1f1f' fontsize='12'> Changed cost basis (X-axis) from cost per visit to cost per recorded attendance-hour. I added the previous cost basis as a detail mark.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f1f1f' fontsize='12'>Benefit: </run>
            <run fontcolor='#1f1f1f' fontsize='12'>The change to cost basis corrects for varying session durations and provides a fair comparison. The cost per visit detail mark provides a comparison on request.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f1f1f' fontsize='12'>Earlier and revised versions:</run>
            <run fontcolor='#1f1f1f' fontsize='12'> See&quot;New Visualization&quot; worksheet for initial version.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='workshop_sessions' name='federated.19q8dpo1ls4fjn118hm4i0l6jhlx' />
          </datasources>
          <datasource-dependencies datasource='federated.19q8dpo1ls4fjn118hm4i0l6jhlx'>
            <column caption='Cost per Recorded Visit' datatype='real' name='[Calculation_1122394328907776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([attendance_visits]) THEN [operating_cost_usd] END) / SUM([attendance_visits])' />
            </column>
            <column caption='Cost per Recorded Attendance-Hour' datatype='real' name='[Calculation_1122394329018369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([attendance_visits]) THEN [operating_cost_usd] END) /&#13;&#10;SUM(IF NOT ISNULL([attendance_visits]) THEN [attendance_visits] * [duration_hours] END)' />
            </column>
            <column caption='Waitlist Requests per 1000 Seats' datatype='real' name='[Calculation_1122394329190402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * SUM([waitlist_count]) / SUM([capacity_seats])' />
            </column>
            <column caption='Candidate ID' datatype='string' name='[Calculation_2078420003057665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [topic]&#13;&#10;  WHEN &quot;Career skills&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C01&quot; ELSE &quot;C02&quot; END&#13;&#10;  WHEN &quot;Creative practice&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C03&quot; ELSE &quot;C04&quot; END&#13;&#10;  WHEN &quot;Digital skills&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C05&quot; ELSE &quot;C06&quot; END&#13;&#10;  WHEN &quot;Personal finance&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C07&quot; ELSE &quot;C08&quot; END&#13;&#10;END' />
            </column>
            <column caption='Attendance Visits' datatype='real' name='[attendance_visits]' role='measure' type='quantitative' />
            <column caption='Capacity Seats' datatype='integer' name='[capacity_seats]' role='measure' type='quantitative' />
            <column caption='Delivery Format' datatype='string' name='[delivery_format]' role='dimension' type='nominal' />
            <column caption='Duration Hours' datatype='real' name='[duration_hours]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2078420003057665]' derivation='None' name='[none:Calculation_2078420003057665:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_format]' derivation='None' name='[none:delivery_format:nk]' pivot='key' type='nominal' />
            <column-instance column='[topic]' derivation='None' name='[none:topic:nk]' pivot='key' type='nominal' />
            <column caption='Operating Cost Usd' datatype='real' name='[operating_cost_usd]' role='measure' type='quantitative' />
            <column caption='Topic' datatype='string' name='[topic]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1122394328907776]' derivation='User' name='[usr:Calculation_1122394328907776:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1122394329018369]' derivation='User' name='[usr:Calculation_1122394329018369:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1122394329190402]' derivation='User' name='[usr:Calculation_1122394329190402:qk]' pivot='key' type='quantitative' />
            <column caption='Waitlist Count' datatype='integer' name='[waitlist_count]' role='measure' type='quantitative' />
