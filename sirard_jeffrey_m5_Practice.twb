  <worksheets>
    <worksheet name='Cost Rankings'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#1f1f1f' fontsize='12'>Digital Skills Online (C06) is the preferred pilot because it has the lowest cost basis ($3.58/visit; $$3.58/visit; $2.39/hour) and highest waitlist demand (3.92/100 seats). Personal Finance Online (C08) is the alternative. Both cost metrics have identical ranking positions which confirms this recommendation. The main tradeoff is higher online demand versus lower online satisfaction/engagement metrics.Limitations include data coverage limits (not all sessions had attendance recorded) and small-size sampling (satisfaction ratings can be influenced by volunteer bias). The group and time comparisons demonstrate high demand across the period, and the cost-demand scatterplot details which topic and format to use.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='workshop_sessions' name='federated.19q8dpo1ls4fjn118hm4i0l6jhlx' />
          </datasources>
          <datasource-dependencies datasource='federated.19q8dpo1ls4fjn118hm4i0l6jhlx'>
            <column caption='Cost per Recorded Visit' datatype='real' name='[Calculation_1122394328907776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([attendance_visits]) THEN [operating_cost_usd] END) / SUM([attendance_visits])' />
            </column>
            <column caption='Cost per Recorded Attendance-Hour' datatype='real' name='[Calculation_1122394329018369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([attendance_visits]) THEN [operating_cost_usd] END) /&#13;&#10;SUM(IF NOT ISNULL([attendance_visits]) THEN [attendance_visits] * [duration_hours] END)' />
            </column>
            <column caption='Waitlist Requests per 1000 Seats' datatype='real' name='[Calculation_1122394329190402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * SUM([waitlist_count]) / SUM([capacity_seats])' />
            </column>
            <column caption='Utilization (%)' datatype='real' name='[Calculation_1122394329423875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * SUM([attendance_visits]) / SUM(IF NOT ISNULL([attendance_visits]) THEN [capacity_seats] END)' />
            </column>
            <column caption='Observed Records' datatype='integer' name='[Calculation_1122394338603016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([attendance_visits]) THEN 1 ELSE 0 END' />
            </column>
            <column caption='Coverage (%)' datatype='real' name='[Calculation_2078420000956416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * SUM([Calculation_1122394338603016]) / COUNT([session_id])' />
            </column>
            <column caption='Candidate ID' datatype='string' name='[Calculation_2078420003057665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [topic]&#13;&#10;  WHEN &quot;Career skills&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C01&quot; ELSE &quot;C02&quot; END&#13;&#10;  WHEN &quot;Creative practice&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C03&quot; ELSE &quot;C04&quot; END&#13;&#10;  WHEN &quot;Digital skills&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C05&quot; ELSE &quot;C06&quot; END&#13;&#10;  WHEN &quot;Personal finance&quot; THEN &#13;&#10;    IF [delivery_format] = &quot;In person&quot; THEN &quot;C07&quot; ELSE &quot;C08&quot; END&#13;&#10;END' />
            </column>
            <column caption='Visit Cost Rank' datatype='integer' name='[Calculation_2078420008087555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_1122394328907776], &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Attendance-Hour Cost Rank' datatype='integer' name='[Visit Cost Rank (copy)_2078420008247300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_1122394329018369], &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Attendance Visits' datatype='real' name='[attendance_visits]' role='measure' type='quantitative' />
